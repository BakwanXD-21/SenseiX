<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<ru.ino.senseix.RightGhzView
		android:id="@+id/container"
		android:layout_width="307dp"
		android:layout_height="match_parent"
		android:gravity="right|center_vertical"
		android:orientation="vertical"
		android:layout_gravity="right|center_vertical">
		<LinearLayout
			android:id="@+id/top_funcbg"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:gravity="right|center_vertical"
			android:orientation="horizontal">
			<TextView
				android:id="@+id/appname"
				android:focusable="false"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="8dp"
				android:layout_marginTop="8dp"
				android:layout_marginRight="30dp"
				android:layout_marginBottom="8dp"
				android:text="WEARE MAGIC"
				android:textSize="28sp"
				android:textStyle="bold"
				android:textColor="#BDBDBD" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/bottom_funcbg"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="horizontal">
			<LinearLayout
				android:id="@+id/system_background"
				android:layout_width="wrap_content"
				android:layout_height="match_parent"
				android:layout_marginLeft="45dp"
				android:layout_marginTop="15dp"
				android:layout_marginRight="15dp"
				android:layout_marginBottom="15dp"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical">
				<FrameLayout
					android:id="@+id/ram_valuebg"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginBottom="10dp"
					android:orientation="vertical">
					<ru.ino.senseix.RamView
						android:id="@+id/ram_view"
						android:layout_width="112dp"
						android:layout_height="50dp"
						android:layout_marginTop="18dp"
						android:padding="8dp"
						android:orientation="horizontal" />
					<TextView
						android:id="@+id/ram_value"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="2.30"
						android:textSize="21sp"
						android:textStyle="bold"
						android:textColor="#EEEEEE"
						android:layout_gravity="center_horizontal|top"
						android:focusable="false" />
				</FrameLayout>
				<FrameLayout
					android:id="@+id/mode_buttonbg"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginBottom="20dp"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical">
					<TextView
						android:id="@+id/mode_text"
						android:focusable="false"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="8dp"
						android:layout_marginRight="8dp"
						android:padding="10dp"
						android:text="TextView"
						android:textSize="12sp"
						android:textColor="#FFFFFF" />
					<ImageView
						android:id="@+id/left_modeicon"
						android:focusable="false"
						android:layout_width="30dp"
						android:layout_height="30dp"
						android:src="@drawable/default_image"
						android:scaleType="fitXY"
						android:layout_gravity="left|center_vertical" />
					<ImageView
						android:id="@+id/right_modeicon"
						android:focusable="false"
						android:layout_width="30dp"
						android:layout_height="30dp"
						android:src="@drawable/default_image"
						android:scaleType="fitXY"
						android:layout_gravity="right|center_vertical" />
				</FrameLayout>
				<ru.ino.senseix.VolumeBarView
					android:id="@+id/volume_bar"
					android:layout_width="67dp"
					android:layout_height="146dp"
					android:layout_marginLeft="13dp"
					android:orientation="vertical" />
				<ImageView
					android:id="@+id/imageview1"
					android:focusable="false"
					android:layout_width="18dp"
					android:layout_height="18dp"
					android:layout_marginLeft="6dp"
					android:layout_marginTop="6dp"
					android:layout_marginRight="8dp"
					android:layout_marginBottom="6dp"
					android:src="@drawable/default_image"
					android:scaleType="fitXY"
					android:layout_gravity="right|center_vertical" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/feature_background"
				android:layout_width="wrap_content"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:layout_weight="1" />
		</LinearLayout>
	</ru.ino.senseix.RightGhzView>
</LinearLayout>
